<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_category_list" model="ir.ui.view">
        <field name="name">purchase.category.list</field>
        <field name="model">purchase.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
                <field name="categories"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_category_form" model="ir.ui.view">
        <field name="name">purchase.category.form</field>
        <field name="model">purchase.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="categories"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_purchase_category" model="ir.actions.act_window">
        <field name="name">Purchase Categories</field>
        <field name="res_model">purchase.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="category_menu_item"
              name="categories"
              parent="categories_menu"
              action="action_purchase_category"
    />
</odoo>